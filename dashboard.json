{
  "datasets": [
    {
      "name": "kpi_summary",
      "displayName": "KPI შეჯამება",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN l.IsProblemLoan = 1 THEN 'პრობლემური'\n",
        "    ELSE 'ჯანსაღი'\n",
        "  END AS loan_status,\n",
        "  COUNT(DISTINCT l.LoanKey) AS loan_count,\n",
        "  ROUND(\n",
        "    COUNT(DISTINCT l.LoanKey) * 100.0 / SUM(COUNT(DISTINCT l.LoanKey)) OVER (),\n",
        "    2\n",
        "  ) AS pct_of_total,\n",
        "  ROUND(AVG(l.AgreementInterestRate), 4) AS avg_interest_rate,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN l.IsRefinanced = 1 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS refinanced_count\n",
        "FROM\n",
        "  getdata.raw.loan l\n",
        "WHERE\n",
        "  l.ValidTo > current_timestamp()\n",
        "GROUP BY\n",
        "  l.IsProblemLoan\n",
        "ORDER BY\n",
        "  loan_count DESC"
      ]
    },
    {
      "name": "loans_by_type",
      "displayName": "სესხები ტიპის მიხედვით",
      "queryLines": [
        "SELECT\n",
        "  lt.LoanTypeNameLat AS loan_type,\n",
        "  CASE\n",
        "    WHEN l.IsProblemLoan = 1 THEN 'პრობლემური'\n",
        "    ELSE 'ჯანსაღი'\n",
        "  END AS loan_status,\n",
        "  COUNT(DISTINCT l.LoanKey) AS loan_count\n",
        "FROM\n",
        "  getdata.raw.loan l\n",
        "    JOIN getdata.raw.loantype lt\n",
        "      ON l.LoanTypeKey = lt.LoanTypeKey\n",
        "WHERE\n",
        "  l.ValidTo > current_timestamp()\n",
        "GROUP BY\n",
        "  lt.LoanTypeNameLat,\n",
        "  l.IsProblemLoan\n",
        "ORDER BY\n",
        "  loan_type,\n",
        "  loan_status"
      ]
    },
    {
      "name": "loans_by_product",
      "displayName": "სესხები პროდუქტის ჯგუფის მიხედვით",
      "queryLines": [
        "SELECT\n",
        "  pg.LoanProductGroupName AS product_group,\n",
        "  CASE\n",
        "    WHEN l.IsProblemLoan = 1 THEN 'პრობლემური'\n",
        "    ELSE 'ჯანსაღი'\n",
        "  END AS loan_status,\n",
        "  COUNT(DISTINCT l.LoanKey) AS loan_count\n",
        "FROM\n",
        "  getdata.raw.loan l\n",
        "    JOIN getdata.raw.loanproductgroup pg\n",
        "      ON l.LoanProductGroupKey = pg.LoanProductGroupKey\n",
        "WHERE\n",
        "  l.ValidTo > current_timestamp()\n",
        "GROUP BY\n",
        "  pg.LoanProductGroupName,\n",
        "  l.IsProblemLoan\n",
        "ORDER BY\n",
        "  product_group,\n",
        "  loan_status"
      ]
    },
    {
      "name": "balance_trends",
      "displayName": "ყოველთვიური ბალანსის დინამიკა",
      "queryLines": [
        "WITH latest_loan AS (\n",
        "  SELECT\n",
        "    LoanKey,\n",
        "    IsProblemLoan\n",
        "  FROM\n",
        "    getdata.raw.loan\n",
        "  WHERE\n",
        "    ValidTo > current_timestamp()\n",
        ")\n",
        "SELECT\n",
        "  DATE_TRUNC('month', lb.Date) AS month,\n",
        "  CASE\n",
        "    WHEN ll.IsProblemLoan = 1 THEN 'პრობლემური'\n",
        "    ELSE 'ჯანსაღი'\n",
        "  END AS loan_status,\n",
        "  ROUND(SUM(lb.BalanceAmount), 2) AS total_balance\n",
        "FROM\n",
        "  getdata.raw.loanbalance lb\n",
        "    JOIN latest_loan ll\n",
        "      ON lb.LoanKey = ll.LoanKey\n",
        "GROUP BY\n",
        "  DATE_TRUNC('month', lb.Date),\n",
        "  ll.IsProblemLoan\n",
        "ORDER BY\n",
        "  month,\n",
        "  loan_status"
      ]
    },
    {
      "name": "loan_financials",
      "displayName": "ყოველთვიური პრობლემური სესხების ფინანსები",
      "queryLines": [
        "WITH latest_loan AS (\n",
        "  SELECT\n",
        "    LoanKey,\n",
        "    IsProblemLoan\n",
        "  FROM\n",
        "    getdata.raw.loan\n",
        "  WHERE\n",
        "    ValidTo > current_timestamp()\n",
        "),\n",
        "monthly_agg AS (\n",
        "  SELECT\n",
        "    DATE_TRUNC('month', lf.Date) AS month,\n",
        "    ROUND(SUM(lf.TotalPaidPrincipalAmount), 2) AS total_paid_principal,\n",
        "    ROUND(SUM(lf.TotalPaidInterestAmount), 2) AS total_paid_interest,\n",
        "    ROUND(SUM(lf.TotalPaidOverduePenaltyAmount), 2) AS total_paid_penalty\n",
        "  FROM\n",
        "    getdata.raw.loanfinance lf\n",
        "      JOIN latest_loan lf2\n",
        "        ON lf.LoanKey = lf2.LoanKey\n",
        "  WHERE\n",
        "    lf2.IsProblemLoan = 1\n",
        "  GROUP BY\n",
        "    DATE_TRUNC('month', lf.Date)\n",
        ")\n",
        "SELECT\n",
        "  month,\n",
        "  'გადახდილი ძირი' AS metric,\n",
        "  total_paid_principal AS amount\n",
        "FROM\n",
        "  monthly_agg\n",
        "UNION ALL\n",
        "SELECT\n",
        "  month,\n",
        "  'გადახდილი პროცენტი' AS metric,\n",
        "  total_paid_interest AS amount\n",
        "FROM\n",
        "  monthly_agg\n",
        "UNION ALL\n",
        "SELECT\n",
        "  month,\n",
        "  'გადახდილი ჯარიმა' AS metric,\n",
        "  total_paid_penalty AS amount\n",
        "FROM\n",
        "  monthly_agg\n",
        "ORDER BY\n",
        "  month,\n",
        "  metric"
      ]
    },
    {
      "name": "loans_by_disbursement",
      "displayName": "სესხები გაცემის ტიპის მიხედვით",
      "queryLines": [
        "SELECT\n",
        "  dt.DisbursementTypeName AS disbursement_type,\n",
        "  CASE\n",
        "    WHEN l.IsProblemLoan = 1 THEN 'პრობლემური'\n",
        "    ELSE 'ჯანსაღი'\n",
        "  END AS loan_status,\n",
        "  COUNT(DISTINCT l.LoanKey) AS loan_count\n",
        "FROM\n",
        "  getdata.raw.loan l\n",
        "    JOIN getdata.raw.loandisbursetype dt\n",
        "      ON l.DisbursementTypeKey = dt.DisbursementTypeKey\n",
        "WHERE\n",
        "  l.ValidTo > current_timestamp()\n",
        "GROUP BY\n",
        "  dt.DisbursementTypeName,\n",
        "  l.IsProblemLoan\n",
        "ORDER BY\n",
        "  disbursement_type,\n",
        "  loan_status"
      ]
    },
    {
      "name": "problem_loan_detail",
      "displayName": "პრობლემური სესხების დეტალები",
      "queryLines": [
        "SELECT\n",
        "  l.LoanKey,\n",
        "  lt.LoanTypeNameLat AS loan_type,\n",
        "  pg.LoanProductGroupName AS product_group,\n",
        "  dt.DisbursementTypeName AS disbursement_type,\n",
        "  l.AgreementStartDate,\n",
        "  l.AgreementEndDate,\n",
        "  l.AgreementInterestRate,\n",
        "  CASE\n",
        "    WHEN l.IsRefinanced = 1 THEN 'დიახ'\n",
        "    ELSE 'არა'\n",
        "  END AS is_refinanced\n",
        "FROM\n",
        "  getdata.raw.loan l\n",
        "    JOIN getdata.raw.loantype lt\n",
        "      ON l.LoanTypeKey = lt.LoanTypeKey\n",
        "    JOIN getdata.raw.loanproductgroup pg\n",
        "      ON l.LoanProductGroupKey = pg.LoanProductGroupKey\n",
        "    LEFT JOIN getdata.raw.loandisbursetype dt\n",
        "      ON l.DisbursementTypeKey = dt.DisbursementTypeKey\n",
        "WHERE\n",
        "  l.IsProblemLoan = 1\n",
        "  AND l.ValidTo > current_timestamp()\n",
        "ORDER BY\n",
        "  l.AgreementStartDate"
      ]
    }
  ],
